# Copy to .env and fill in your API keys (never commit .env)

GOOGLE_API_KEY=
GROQ_API_KEY=
GOOGLE_MAPS_API_KEY=

# Optional overrides
LOG_LEVEL=INFO
LOG_DIR=E:\log
# Comma-separated origins for production, e.g. http://localhost:8080,https://mygame.example
CORS_ORIGINS=*

# Model identifiers (defaults match ai_settings.py)
# PRIMARY_MODEL=gemini-3.5-flash
# BACKUP_MODEL=gemini-3.1-flash-lite
# LOCAL_MODEL=llama3.2
# GROQ_FALLBACK_MODEL=llama-3.1-70b-versatile
# EMBEDDING_MODEL=all-MiniLM-L6-v2
